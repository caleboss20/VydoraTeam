# Expo public env (safe to expose in the client bundle)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=241574699947-th6as6vgkvarafrmjrgi6rqvigchup20.apps.googleusercontent.com

# Dual backends — app probes /health and auto-fails over cloud ↔ local.
# Prefer: cloud | local
EXPO_PUBLIC_API_PREFER=local

# Render cloud backend (also the in-code default — probe /health to confirm live)
# EXPO_PUBLIC_API_BASE_CLOUD=https://vydora-backend-mmgm.onrender.com/api/v1
# EXPO_PUBLIC_WS_BASE_CLOUD=https://vydora-backend-mmgm.onrender.com/ws

# Local Spring Boot — use your PC's Wi‑Fi IPv4 (ipconfig → Wireless LAN Wi‑Fi).
# Phone on same Wi‑Fi must NOT use 127.0.0.1 (that's only this PC).
# Android emulator: http://10.0.2.2:8080/api/v1
# iOS simulator: http://localhost:8080/api/v1
EXPO_PUBLIC_API_BASE_LOCAL=http://10.149.82.76:8080/api/v1
EXPO_PUBLIC_WS_BASE_LOCAL=http://10.149.82.76:8080/ws

# Legacy aliases (treated as local if *_LOCAL unset)
# EXPO_PUBLIC_API_BASE=http://127.0.0.1:8080/api/v1
# EXPO_PUBLIC_WS_BASE=http://127.0.0.1:8080/ws
